# Dark Triad Detector — Frontend Server
# Copy this file to .env and fill in your values

# Express session secret (change to a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/dark_triad

# Python backend API base URL
API_BASE=https://pd.api.slmgx.edu.lk

# Public-facing site URL (used in social share links)
SITE_URL=https://slmgx.edu.lk/dark-traid

# Node environment (development | production)
NODE_ENV=development

# Port to listen on
PORT=3000

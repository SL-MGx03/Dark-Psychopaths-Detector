<%- include('partials/header') %>

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-orb hero-orb--1"></div>
    <div class="hero-orb hero-orb--2"></div>
    <div class="hero-orb hero-orb--3"></div>
  </div>
  <div class="container hero-content">
    <div class="hero-badge">🔬 ML-Powered Personality Analysis</div>
    <h1 class="hero-title">How Dark Are <span class="text-accent">You?</span></h1>
    <p class="hero-sub">
      Answer 27 questions from the scientifically validated <strong>Short Dark Triad (SD3)</strong> scale.
      Our neural network scores your Machiavellianism, Narcissism, and Psychopathy — then an AI writes
      your brutally honest (and darkly funny) personality report.
    </p>

    <% if (error) { %>
      <div class="alert alert--error" role="alert"><%= error %></div>
    <% } %>

    <form action="<%= basePath %>/start" method="POST" class="nickname-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="nickname-form__field">
        <label for="nickname" class="nickname-form__label">Enter your nickname to begin</label>
        <div class="nickname-form__row">
          <input
            type="text"
            id="nickname"
            name="nickname"
            class="input"
            placeholder="e.g. ShadowLord99"
            minlength="2"
            maxlength="40"
            required
            autocomplete="nickname"
            aria-describedby="nickname-hint"
          />
          <button type="submit" class="btn btn--primary">
            Start Test <span aria-hidden="true">→</span>
          </button>
        </div>
        <span id="nickname-hint" class="input-hint">2–40 characters. No account needed.</span>
      </div>
    </form>
  </div>
</section>

<section class="features section">
  <div class="container">
    <h2 class="section-title">What You'll Discover</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">🎭</div>
        <h3>Machiavellianism</h3>
        <p>How strategically manipulative are you? Do you play the long game or wear your heart on your sleeve?</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">👑</div>
        <h3>Narcissism</h3>
        <p>Grandiosity, entitlement, and admiration-seeking — find out exactly how special you think you are.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Psychopathy</h3>
        <p>Impulsivity, callousness, and thrill-seeking. Your risk tolerance revealed in cold, hard numbers.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🤖</div>
        <h3>AI Analysis</h3>
        <p>A large language model reads your scores and delivers a witty, cutting, and surprisingly accurate verdict.</p>
      </div>
    </div>
  </div>
</section>

<section class="how-it-works section section--dark">
  <div class="container">
    <h2 class="section-title">How It Works</h2>
    <ol class="steps">
      <li class="step">
        <div class="step-num">1</div>
        <div class="step-body">
          <h3>Enter your nickname</h3>
          <p>No signup. No email. Just a name.</p>
        </div>
      </li>
      <li class="step">
        <div class="step-num">2</div>
        <div class="step-body">
          <h3>Answer 27 questions</h3>
          <p>Rate each statement from 1 (disagree) to 5 (agree). Takes about 3 minutes.</p>
        </div>
      </li>
      <li class="step">
        <div class="step-num">3</div>
        <div class="step-body">
          <h3>Neural network scores you</h3>
          <p>A PyTorch autoencoder trained on real SD3 data maps your answers to three trait scores.</p>
        </div>
      </li>
      <li class="step">
        <div class="step-num">4</div>
        <div class="step-body">
          <h3>AI writes your profile</h3>
          <p>An LLM synthesises the scores into a darkly funny, personalised report.</p>
        </div>
      </li>
      <li class="step">
        <div class="step-num">5</div>
        <div class="step-body">
          <h3>Share or download</h3>
          <p>Download your result card or share it with friends on WhatsApp, Facebook, or Instagram.</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<section class="disclaimer section">
  <div class="container disclaimer-inner">
    <p>
      ⚠️ <strong>Disclaimer:</strong> This tool is designed for entertainment and self-reflection. Results are
      generated by a machine learning model and should <em>not</em> be interpreted as a clinical or
      psychological diagnosis. Data is processed according to our
      <a href="<%= basePath %>/privacy">Privacy Policy</a>.
    </p>
  </div>
</section>

<%- include('partials/footer') %>

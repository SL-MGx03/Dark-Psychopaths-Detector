<%- include('partials/header') %>

<section class="result-hero">
  <div class="result-hero-bg" aria-hidden="true">
    <div class="hero-orb hero-orb--1"></div>
    <div class="hero-orb hero-orb--2"></div>
  </div>
  <div class="container">
    <div class="result-intro">
      <span class="result-badge">🧪 Analysis Complete</span>
      <h1 class="result-title"><%= nickname %>'s <span class="text-accent">Dark Profile</span></h1>
      <p class="result-subtitle">Your neural network scores and AI-generated psychological verdict.</p>
    </div>
  </div>
</section>

<section class="result-section section">
  <div class="container">

    <!-- Score dials -->
    <div class="scores-grid" id="scoresGrid">
      <div class="score-card" data-trait="machiavellianism" data-value="<%= Math.round(scores.machiavellianism * 100) %>">
        <div class="score-dial-wrap">
          <svg class="score-dial" viewBox="0 0 120 120" aria-hidden="true">
            <circle class="dial-track" cx="60" cy="60" r="52"/>
            <circle class="dial-fill dial-fill--mach" cx="60" cy="60" r="52"
              stroke-dasharray="326.73"
              stroke-dashoffset="<%= 326.73 - (326.73 * scores.machiavellianism) %>"/>
          </svg>
          <div class="score-dial__inner">
            <span class="score-pct"><%= Math.round(scores.machiavellianism * 100) %><small>%</small></span>
          </div>
        </div>
        <div class="score-card__label">
          <span class="score-emoji" aria-hidden="true">🎭</span>
          <h3>Machiavellianism</h3>
        </div>
      </div>

      <div class="score-card" data-trait="narcissism" data-value="<%= Math.round(scores.narcissism * 100) %>">
        <div class="score-dial-wrap">
          <svg class="score-dial" viewBox="0 0 120 120" aria-hidden="true">
            <circle class="dial-track" cx="60" cy="60" r="52"/>
            <circle class="dial-fill dial-fill--narc" cx="60" cy="60" r="52"
              stroke-dasharray="326.73"
              stroke-dashoffset="<%= 326.73 - (326.73 * scores.narcissism) %>"/>
          </svg>
          <div class="score-dial__inner">
            <span class="score-pct"><%= Math.round(scores.narcissism * 100) %><small>%</small></span>
          </div>
        </div>
        <div class="score-card__label">
          <span class="score-emoji" aria-hidden="true">👑</span>
          <h3>Narcissism</h3>
        </div>
      </div>

      <div class="score-card" data-trait="psychopathy" data-value="<%= Math.round(scores.psychopathy * 100) %>">
        <div class="score-dial-wrap">
          <svg class="score-dial" viewBox="0 0 120 120" aria-hidden="true">
            <circle class="dial-track" cx="60" cy="60" r="52"/>
            <circle class="dial-fill dial-fill--psyc" cx="60" cy="60" r="52"
              stroke-dasharray="326.73"
              stroke-dashoffset="<%= 326.73 - (326.73 * scores.psychopathy) %>"/>
          </svg>
          <div class="score-dial__inner">
            <span class="score-pct"><%= Math.round(scores.psychopathy * 100) %><small>%</small></span>
          </div>
        </div>
        <div class="score-card__label">
          <span class="score-emoji" aria-hidden="true">⚡</span>
          <h3>Psychopathy</h3>
        </div>
      </div>
    </div>

    <!-- AI Report -->
    <div class="report-cards">
      <% if (report.specimen_type) { %>
      <div class="report-card report-card--specimen">
        <div class="report-card__header">
          <span aria-hidden="true">🧪</span> Specimen Type
        </div>
        <div class="report-card__body"><%- report.specimen_type.replace(/\n/g,'<br>') %></div>
      </div>
      <% } %>

      <% if (report.neural_breakdown) { %>
      <div class="report-card report-card--breakdown">
        <div class="report-card__header">
          <span aria-hidden="true">📉</span> Neural Breakdown
        </div>
        <div class="report-card__body"><%- report.neural_breakdown.replace(/\n/g,'<br>') %></div>
      </div>
      <% } %>

      <% if (report.dark_future) { %>
      <div class="report-card report-card--future">
        <div class="report-card__header">
          <span aria-hidden="true">🔮</span> The Dark Future
        </div>
        <div class="report-card__body"><%- report.dark_future.replace(/\n/g,'<br>') %></div>
      </div>
      <% } %>

      <% if (report.summary) { %>
      <div class="report-card report-card--summary">
        <div class="report-card__header">
          <span aria-hidden="true">📜</span> Verdict
        </div>
        <div class="report-card__body report-card__body--verdict">
          &ldquo;<%- report.summary %>&rdquo;
        </div>
      </div>
      <% } %>
    </div>

    <!-- Share & Download -->
    <div class="share-section">
      <h2 class="share-title">Share Your Dark Side 😈</h2>
      <p class="share-desc">Challenge your friends to discover their own Dark Triad scores.</p>

      <div class="share-buttons">
        <a
          href="https://wa.me/?text=I+just+discovered+my+Dark+Triad+score!+Find+out+yours+at+<%= encodeURIComponent(siteUrl) %>"
          target="_blank" rel="noopener"
          class="share-btn share-btn--whatsapp"
          aria-label="Share on WhatsApp"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>

        <a
          href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(siteUrl) %>"
          target="_blank" rel="noopener"
          class="share-btn share-btn--facebook"
          aria-label="Share on Facebook"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>

        <a
          href="https://twitter.com/intent/tweet?text=I+just+got+my+Dark+Triad+score!+Curious+about+yours%3F&url=<%= encodeURIComponent(siteUrl) %>"
          target="_blank" rel="noopener"
          class="share-btn share-btn--twitter"
          aria-label="Share on X / Twitter"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X / Twitter
        </a>

        <button class="share-btn share-btn--copy" id="copyLinkBtn" aria-label="Copy link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
          Copy Link
        </button>
      </div>

      <div class="download-section">
        <h3>Download Your Result Card</h3>
        <p>Save a shareable image of your personality profile.</p>
        <button class="btn btn--secondary" id="downloadCardBtn">
          ⬇ Download Card
        </button>
        <canvas id="resultCanvas" hidden aria-hidden="true"></canvas>
      </div>
    </div>

    <div class="retake-section">
      <a href="/" class="btn btn--ghost">↩ Take the Test Again</a>
    </div>

  </div>
</section>

<!-- Pass data to JS -->
<script>
  window.__RESULT__ = {
    nickname: <%- JSON.stringify(nickname) %>,
    scores: <%- JSON.stringify(scores) %>,
    specimenType: <%- JSON.stringify(report.specimen_type || '') %>,
    summary: <%- JSON.stringify(report.summary || '') %>,
    siteUrl: <%- JSON.stringify(siteUrl) %>
  };
</script>
<script src="/js/result.js"></script>
<%- include('partials/footer') %>

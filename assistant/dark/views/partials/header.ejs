<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Discover your Dark Triad personality traits with our ML-powered analysis tool. Take the Short Dark Triad questionnaire and see your results." />
  <meta name="theme-color" content="#0d0d1a" />
  <title><%= title %> | Dark Triad Detector</title>

  <!-- Open Graph -->
  <meta property="og:title" content="Dark Triad Detector — Are you secretly diabolical?" />
  <meta property="og:description" content="Take the ML-powered Dark Triad personality test and discover your inner darkness." />
  <meta property="og:url" content="<%= typeof siteUrl !== 'undefined' ? siteUrl : '' %>" />
  <meta property="og:type" content="website" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />

  <!-- Styles -->
  <link rel="stylesheet" href="<%= basePath %>/css/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="<%= basePath %>/" class="brand" aria-label="Dark Triad Detector Home">
        <span class="brand-icon" aria-hidden="true">🧠</span>
        <span class="brand-name">Dark Triad <span class="brand-accent">Detector</span></span>
      </a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href="<%= basePath %>/" class="nav-link">Home</a>
        <a href="<%= basePath %>/quiz" class="nav-link">Take the Quiz</a>
        <a href="<%= basePath %>/privacy" class="nav-link">Privacy</a>
      </nav>
      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="mobile-nav" id="mobile-nav" hidden>
      <a href="<%= basePath %>/" class="nav-link">Home</a>
      <a href="<%= basePath %>/quiz" class="nav-link">Take the Quiz</a>
      <a href="<%= basePath %>/privacy" class="nav-link">Privacy</a>
      <a href="<%= basePath %>/terms" class="nav-link">Terms</a>
    </div>
  </header>
  <main id="main-content">
